{
  "$schema": "https://json.schemastore.org/appsettings.json",
  "FidelSec": {
    "LogDirectory": "%PROGRAMDATA%\\FidelSec\\Logs",
    "ForensicLogDirectory": "%PROGRAMDATA%\\FidelSec\\ForensicLogs",
    "DefaultBufferSizeMb": 1,
    "DefaultBadSectorRetries": 3,
    "DefaultZeroFillBadSectors": true,
    "DefaultVerifyAfterImaging": true,
    "MaxConcurrentJobs": 1,
    "ChecksumIntervalMb": 256
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "%PROGRAMDATA%\\FidelSec\\Logs\\fidelSec-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ]
  }
}
