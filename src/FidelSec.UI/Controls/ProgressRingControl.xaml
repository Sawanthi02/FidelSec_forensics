<UserControl x:Class="FidelSec.UI.Controls.ProgressRingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Circular progress ring.
        Bind Value (0–100) and optionally RingSize, TrackColor, ProgressColor, SubLabel.
    -->
    <Canvas x:Name="RootCanvas">
        <!-- Background track ring -->
        <Ellipse x:Name="TrackEllipse" Fill="Transparent" />
        <!-- Foreground arc (drawn in code-behind) -->
        <Path x:Name="ProgressArc" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" />
        <!-- Centre: percentage value -->
        <TextBlock x:Name="ValueTextBlock"
                   FontFamily="Segoe UI"
                   FontWeight="Bold"
                   TextAlignment="Center" />
        <!-- Centre: subtitle label (e.g. "COMPLETE") -->
        <TextBlock x:Name="SubLabelTextBlock"
                   FontFamily="Segoe UI"
                   TextAlignment="Center" />
    </Canvas>
</UserControl>
