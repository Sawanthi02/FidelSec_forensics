<Window x:Class="FidelSec.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FidelSec.UI.Views"
        Title="FidelSec Forensic Imager"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="600"
        Style="{StaticResource DarkWindow}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />   <!-- Title bar -->
            <RowDefinition Height="*" />    <!-- Content -->
            <RowDefinition Height="28" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── Title Bar ───────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔒" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="FidelSec" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text=" Forensic Imager" FontSize="18" FontWeight="Light"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
                    <Border Background="{StaticResource BgTertiary}" CornerRadius="4"
                            Padding="8,2" Margin="16,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="● ADMIN" FontSize="10" Foreground="{StaticResource SuccessBrush}"
                                   FontFamily="{StaticResource MonoFont}" />
                    </Border>
                    <Border Background="{StaticResource ErrorBrush}" CornerRadius="4"
                            Padding="8,2" Margin="16,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsAdminMode, Converter={StaticResource InverseBoolToVisConverter}}">
                        <TextBlock Text="⚠ NOT ADMIN" FontSize="10" Foreground="White"
                                   FontFamily="{StaticResource MonoFont}" />
                    </Border>
                </StackPanel>
                <TextBlock Text="v1.0 — Windows Forensic Disk Imager"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" FontSize="11" />
            </Grid>
        </Border>

        <!-- ── Main Content: 3-column layout ────────────────── -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />   <!-- Step labels -->
                <RowDefinition Height="*" />    <!-- Panels -->
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="400" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="340" MinWidth="280" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Step labels row -->
            <Border Grid.Row="0" Grid.Column="0"
                    Background="#22A855C7" BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="0,0,0,2">
                <TextBlock Text="① Selecteer bron"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Row="0" Grid.Column="2"
                    Background="#223A5AFF" BorderBrush="#3A5AFF"
                    BorderThickness="0,0,0,2">
                <TextBlock Text="② Stel in &amp; configureer"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#7B9FFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Border Grid.Row="0" Grid.Column="4"
                    Background="#2222C55E" BorderBrush="{StaticResource SuccessBrush}"
                    BorderThickness="0,0,0,2">
                <TextBlock Text="③ Start acquisitie"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource SuccessBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Left: Device List -->
            <views:DeviceListView Grid.Row="1" Grid.Column="0" DataContext="{Binding DeviceList}" />

            <GridSplitter Grid.Row="1" Grid.Column="1" Width="5"
                          Background="{StaticResource BorderBrush}"
                          HorizontalAlignment="Stretch" />

            <!-- Centre: Imaging Configuration -->
            <views:ImagingConfigView Grid.Row="1" Grid.Column="2"
                                     DataContext="{Binding ImagingConfig}" />

            <GridSplitter Grid.Row="1" Grid.Column="3" Width="5"
                          Background="{StaticResource BorderBrush}"
                          HorizontalAlignment="Stretch" />

            <!-- Right: Imaging Progress -->
            <views:ImagingProgressView Grid.Row="1" Grid.Column="4"
                                       DataContext="{Binding ImagingProgress}" />
        </Grid>

        <!-- ── Status Bar ────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Margin="16,0" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="11" />
        </Border>
    </Grid>
</Window>
