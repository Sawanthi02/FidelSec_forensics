<Window x:Class="FidelSec.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FidelSec.UI.Views"
        Title="FidelSec Forensic Imager"
        Width="1360" Height="860"
        MinWidth="800" MinHeight="600"
        Style="{StaticResource DarkWindow}"
        WindowStartupLocation="CenterScreen"
        SizeChanged="OnWindowSizeChanged"
        KeyDown="OnWindowKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />   <!-- Title bar -->
            <RowDefinition Height="*" />    <!-- Content -->
            <RowDefinition Height="32" />   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- 
             TITLE BAR
         -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <!-- Left: logo + name -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="FidelSec" FontSize="19" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text=" Forensic Imager" FontSize="19" FontWeight="Light"
                               Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />

                    <!-- Admin badge -->
                    <Border Style="{StaticResource BadgeSuccess}" Margin="16,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsAdminMode, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text=" ADMIN" FontSize="11" Foreground="{StaticResource SuccessBrush}"
                                   FontFamily="{StaticResource MonoFont}" FontWeight="Bold" />
                    </Border>
                    <Border Style="{StaticResource BadgeError}" Margin="16,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsAdminMode, Converter={StaticResource InverseBoolToVisConverter}}">
                        <TextBlock Text=" NOT ADMIN" FontSize="11" Foreground="{StaticResource ErrorBrush}"
                                   FontFamily="{StaticResource MonoFont}" FontWeight="Bold" />
                    </Border>

                    <!-- Touch device badge -->
                    <Border Style="{StaticResource BadgeAccent}" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsTouchDevice, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text=" TOUCH" FontSize="11" Foreground="{StaticResource AccentBrush}"
                                   FontFamily="{StaticResource MonoFont}" FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Right: version + toolbar buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="v1.0  Windows x64"
                               Foreground="{StaticResource TextSecondary}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,16,0" />

                    <!-- Compact / wide toggle -->
                    <Button x:Name="CompactToggleButton"
                            Style="{StaticResource IconButton}"
                            ToolTip="Wissel tussen panelen / tabbladen (compact mode)"
                            Click="OnCompactToggleClick"
                            Content="" FontSize="18" />

                    <!-- Kiosk fullscreen toggle (F11) -->
                    <Button x:Name="KioskButton"
                            Style="{StaticResource IconButton}"
                            ToolTip="Volledig scherm (kiosk mode)  ook F11"
                            Click="OnKioskToggleClick"
                            Content="" FontSize="18" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 
             MAIN CONTENT
         -->
        <Grid Grid.Row="1">

            <!--  WIDE LAYOUT ( 900 px)  3-column  -->
            <Grid x:Name="WideLayout">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />  <!-- Step labels -->
                    <RowDefinition Height="*" />   <!-- Panels -->
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" MinWidth="220" MaxWidth="440" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="360" MinWidth="280" MaxWidth="480" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- Step labels -->
                <Border Grid.Row="0" Grid.Column="0"
                        Background="#22A855C7" BorderBrush="{StaticResource AccentBrush}"
                        BorderThickness="0,0,0,2">
                    <TextBlock Text=" Selecteer bron"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Row="0" Grid.Column="2"
                        Background="#223A5AFF" BorderBrush="#3A5AFF"
                        BorderThickness="0,0,0,2">
                    <TextBlock Text=" Stel in &amp; configureer"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#7B9FFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Row="0" Grid.Column="4"
                        Background="#2222C55E" BorderBrush="{StaticResource SuccessBrush}"
                        BorderThickness="0,0,0,2">
                    <TextBlock Text=" Start acquisitie"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <!-- Left: Device List -->
                <views:DeviceListView Grid.Row="1" Grid.Column="0"
                                      DataContext="{Binding DeviceList}" />

                <GridSplitter Grid.Row="1" Grid.Column="1" Width="6"
                              Background="{StaticResource BorderBrush}"
                              HorizontalAlignment="Stretch" />

                <!-- Centre: Imaging Configuration -->
                <views:ImagingConfigView Grid.Row="1" Grid.Column="2"
                                         DataContext="{Binding ImagingConfig}" />

                <GridSplitter Grid.Row="1" Grid.Column="3" Width="6"
                              Background="{StaticResource BorderBrush}"
                              HorizontalAlignment="Stretch" />

                <!-- Right: Imaging Progress -->
                <views:ImagingProgressView Grid.Row="1" Grid.Column="4"
                                           DataContext="{Binding ImagingProgress}" />
            </Grid>

            <!--  COMPACT LAYOUT (< 900 px)  TabControl  -->
            <TabControl x:Name="CompactLayout" Visibility="Collapsed">
                <TabItem Header=" Bron">
                    <views:DeviceListView DataContext="{Binding DeviceList}" />
                </TabItem>
                <TabItem Header=" Configureer">
                    <views:ImagingConfigView DataContext="{Binding ImagingConfig}" />
                </TabItem>
                <TabItem Header=" Acquisitie">
                    <views:ImagingProgressView DataContext="{Binding ImagingProgress}" />
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 
             STATUS BAR
         -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12" />
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="11" Foreground="{StaticResource TextSecondary}">
                    <Run Text="F11" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                    <Run Text=" Kiosk mode" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>