<UserControl x:Class="FidelSec.UI.Views.DeviceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FidelSec.Core.Models;assembly=FidelSec.Core"
             Background="{StaticResource BgPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header + toolbar -->
            <RowDefinition Height="*" />     <!-- Device list -->
            <RowDefinition Height="Auto" />  <!-- Status strip -->
        </Grid.RowDefinitions>

        <!--  HEADER TOOLBAR  -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <StackPanel>
                <!-- Title + action buttons -->
                <Grid Margin="0,0,0,10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Evidence Sources"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Selecteer een schijf of testbestand"
                                   FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- Scan + test-file buttons  full width, touch sized -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding ScanDevicesCommand}"
                            IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}"
                            ToolTip="Zoek naar aangesloten schijven via Windows (vereist Administrator)">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Scan schijven" FontWeight="Bold" FontSize="13" />
                                <TextBlock Text="vereist Admin" FontSize="10"
                                           Foreground="#BBFFFFFF" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddTestFileCommand}"
                            ToolTip="Selecteer een gewoon bestand om de pipeline te testen zonder fysieke schijf">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Test bestand" FontWeight="Bold" FontSize="13" />
                                <TextBlock Text="geen Admin nodig" FontSize="10"
                                           Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Scanning spinner -->
                <Border Background="{StaticResource BgTertiary}" CornerRadius="6"
                        Padding="10,7" Margin="0,8,0,0"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Schijven worden gescand"
                                   FontSize="13" Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!--  DEVICE LIST  -->
        <Grid Grid.Row="1">
            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Devices.Count, Converter={StaticResource NullToVisConverter}}">
            </StackPanel>

            <ListBox ItemsSource="{Binding Devices}"
                     SelectedItem="{Binding SelectedDevice}"
                     BorderThickness="0,0,1,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Background="{StaticResource BgPrimary}">

                <!-- Empty state overlay -->
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Style.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBox">
                                            <Border Background="{StaticResource BgPrimary}">
                                                <StackPanel VerticalAlignment="Center"
                                                            HorizontalAlignment="Center"
                                                            Margin="24">
                                                    <TextBlock Text="" FontSize="48"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,16" />
                                                    <TextBlock Text="Geen apparaten gevonden"
                                                               FontSize="15" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,0,0,8" />
                                                    <TextBlock TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextSecondary}">
                                                        Klik <Run FontWeight="Bold" Foreground="{StaticResource AccentBrush}">Scan schijven</Run> om fysieke schijven te detecteren, of gebruik <Run FontWeight="Bold" Foreground="{StaticResource TextPrimary}">Test bestand</Run> voor een testrun.
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>

                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PhysicalDevice}">
                        <!-- Device card  min 80 px, touch-friendly -->
                        <Grid Margin="0,2,0,2" MinHeight="80">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Drive icon -->
                            <Border Grid.Column="0"
                                    Background="{StaticResource BgTertiary}"
                                    CornerRadius="10"
                                    Width="44" Height="44"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="" FontSize="22"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <!-- Drive info -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                <!-- ID + removable badge -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                                    <TextBlock Text="{Binding DeviceId}"
                                               FontWeight="Bold" FontSize="14"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4"
                                            Background="{StaticResource WarningBrush}"
                                            Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVis}}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="USB" FontSize="10" FontWeight="Bold"
                                                   Foreground="#1E1E2E" />
                                    </Border>
                                    <Border Margin="4,0,0,0" Padding="6,2" CornerRadius="4"
                                            Background="{StaticResource BgTertiary}"
                                            Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="READ-ONLY" FontSize="10"
                                                   Foreground="{StaticResource TextSecondary}" />
                                    </Border>
                                </StackPanel>

                                <!-- Model (trimmed) -->
                                <TextBlock Text="{Binding Model}"
                                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,3" />

                                <!-- Size + interface -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding SizeHuman}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="  " FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" />
                                    <TextBlock Text="{Binding InterfaceType}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondary}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Serial + partition style (right column) -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                <TextBlock Text="{Binding PartitionStyle}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Right" />
                                <TextBlock FontFamily="{StaticResource MonoFont}"
                                           FontSize="10"
                                           Foreground="{StaticResource TextSecondary}"
                                           HorizontalAlignment="Right"
                                           Margin="0,2,0,0">
                                    <Run Text="S/N " />
                                    <Run Text="{Binding SerialNumber}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!--  STATUS STRIP  -->
        <Border Grid.Row="2"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,1,0"
                Padding="14,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBlock Text="{Binding ScanStatus}"
                           FontSize="12" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>