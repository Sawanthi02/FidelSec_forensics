<UserControl x:Class="FidelSec.UI.Views.DeviceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FidelSec.Core.Models;assembly=FidelSec.Core"
             Background="{StaticResource BgPrimary}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + buttons -->
        <Border Grid.Row="0"
                Background="{StaticResource BgSecondary}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,1"
                Padding="12,10">
            <StackPanel>
                <Grid>
                    <TextBlock Text="Evidence Sources"
                               Style="{StaticResource SectionHeader}"
                               VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="📂 Test File"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,6,0"
                                FontSize="11"
                                Padding="8,5"
                                ToolTip="Test de applicatie met een gewoon bestand (geen fysieke schijf nodig)"
                                Command="{Binding AddTestFileCommand}" />
                        <Button Content="⟳ Scan"
                                Style="{StaticResource PrimaryButton}"
                                FontSize="11"
                                Padding="10,5"
                                ToolTip="Zoek naar aangesloten schijven en USB-sticks (vereist Administrator)"
                                Command="{Binding ScanDevicesCommand}"
                                IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Grid>
                <!-- Help tekst -->
                <Border Background="{StaticResource BgTertiary}" CornerRadius="4"
                        Padding="8,6" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap">
                            <Run Text="⟳ Scan" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                            <Run Text=" — detecteert fysieke schijven via Windows (vereist Admin-rechten)." />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="0,4,0,0">
                            <Run Text="📂 Test File" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                            <Run Text=" — selecteer een gewoon bestand om de pipeline te testen zonder Admin of schijf." />
                        </TextBlock>
                        <TextBlock Text="Klik daarna op een schijf in de lijst om deze te selecteren →"
                                   FontSize="10" Foreground="{StaticResource AccentBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Device list -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0"
                     ItemsSource="{Binding Devices}"
                     SelectedItem="{Binding SelectedDevice}"
                     BorderThickness="0,0,1,0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:PhysicalDevice}">
                        <Grid Margin="0,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Drive icon + ID -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding DeviceId}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="13" />
                                <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="3"
                                        Background="{StaticResource BgTertiary}"
                                        Visibility="{Binding IsRemovable, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="USB" FontSize="9"
                                               Foreground="{StaticResource WarningBrush}" />
                                </Border>
                            </StackPanel>

                            <!-- Model -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding Model}"
                                       Style="{StaticResource SubLabel}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,2,0,0" />

                            <!-- Size + Interface -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding SizeHuman}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text=" · " Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                <TextBlock Text="{Binding InterfaceType}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="11" />
                            </StackPanel>

                            <!-- Serial / partition style -->
                            <TextBlock Grid.Row="3"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,2,0,0">
                                <Run Text="S/N: " />
                                <Run Text="{Binding SerialNumber}" />
                                <Run Text="  " />
                                <Run Text="{Binding PartitionStyle}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Status bar -->
            <Border Grid.Row="1"
                    Background="{StaticResource BgSecondary}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,1,0"
                    Padding="12,6">
                <TextBlock Text="{Binding ScanStatus}"
                           Style="{StaticResource SubLabel}" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
