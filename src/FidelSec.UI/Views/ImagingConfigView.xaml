<UserControl x:Class="FidelSec.UI.Views.ImagingConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:FidelSec.Core.Models;assembly=FidelSec.Core"
             Background="{StaticResource BgPrimary}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="14">

            <!--  Workflow hint  -->
            <Border Background="{StaticResource BgTertiary}" CornerRadius="10"
                    Padding="14,12" Margin="0,0,0,14"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="3,0,0,0">
                <StackPanel>
                    <TextBlock Text="Hoe werkt dit scherm?"
                               FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" LineHeight="20">
                        <Run Text="1." FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <Run Text=" Controleer de geselecteerde bron." />
                        <LineBreak />
                        <Run Text="2." FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <Run Text=" Kies een output-bestand via " />
                        <Run Text="Browse" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" />
                        <Run Text="." />
                        <LineBreak />
                        <Run Text="3." FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <Run Text=" Kies hashalgoritmen (MD5 + SHA-256 aanbevolen)." />
                        <LineBreak />
                        <Run Text="4." FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <Run Text=" Vul zaaknummer, bewijsnummer en onderzoeker in." />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--  Source Device  -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Bronapparaat" Style="{StaticResource SectionHeader}" />
                    <TextBlock Text="{Binding SourceDevice.DevicePath, FallbackValue='Geen apparaat geselecteerd'}"
                               Style="{StaticResource MonoValue}" FontSize="13"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SourceDevice.Model, FallbackValue='--'}"
                               FontSize="12" Foreground="{StaticResource TextSecondary}"
                               Margin="0,3,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Style="{StaticResource BadgeAccent}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding SourceDevice.SizeHuman, FallbackValue='--'}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                        <Border Style="{StaticResource BadgeAccent}">
                            <TextBlock FontSize="12" Foreground="{StaticResource TextSecondary}">
                                <Run Text="{Binding SourceDevice.LogicalSectorSize, FallbackValue='--'}" />
                                <Run Text=" B/sector" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  Output  -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Output" Style="{StaticResource SectionHeader}" />

                    <TextBlock Text="Output bestand *" Style="{StaticResource SubLabel}"
                               Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Pad naar het output image-bestand" />
                        <Button Grid.Column="2"
                                Content=" Browse"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="100"
                                ToolTip="Kies een opslaglocatie en bestandsnaam"
                                Command="{Binding BrowseOutputPathCommand}" />
                    </Grid>
                    <TextBlock FontSize="11" FontStyle="Italic"
                               Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,12">
                         Navigeer naar een map, typ een naam (bijv. usb_image) en klik Opslaan.
                    </TextBlock>

                    <TextBlock Text="Formaat" Style="{StaticResource SubLabel}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding AvailableFormats}"
                              SelectedItem="{Binding SelectedFormat}"
                              Margin="0,0,0,4"
                              ToolTip="RAW (.dd) = 1-op-1 kopie. E01 = forensisch standaard met metadata." />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,0,0,12">
                        RAW (.dd) = eenvoudig. E01 = forensisch standaard voor rechtbank.
                    </TextBlock>

                    <!-- Split image toggle -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  Content="Splits image in segmenten"
                                  IsChecked="{Binding SplitImage}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    IsEnabled="{Binding SplitImage}">
                            <TextBox Text="{Binding SplitSizeGb}"
                                     Width="70" Margin="0,0,6,0"
                                     ToolTip="GB per segment" />
                            <TextBlock Text="GB" VerticalAlignment="Center"
                                       Style="{StaticResource SubLabel}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!--  Hash Algorithms  -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Hash Algoritmen" Style="{StaticResource SectionHeader}" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,0,0,12">
                        Een hash is een digitale vingerafdruk van het image. Selecteer minimaal n algoritme.
                    </TextBlock>

                    <CheckBox Content="MD5   snel, veel gebruikt"
                              IsChecked="{Binding HashMd5}" Margin="0,0,0,8" />
                    <CheckBox Content="SHA-1"
                              IsChecked="{Binding HashSha1}" Margin="0,0,0,8" />
                    <CheckBox Content="SHA-256   aanbevolen voor rechtbank"
                              IsChecked="{Binding HashSha256}" Margin="0,0,0,8" />
                    <Separator />
                    <CheckBox Content="Verifieer image n acquisitie"
                              IsChecked="{Binding VerifyAfterImaging}"
                              ToolTip="Vergelijkt hash van het opgeslagen image met de bron" />
                </StackPanel>
            </Border>

            <!--  Bad Sector Handling  -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Slechte Sectoren" Style="{StaticResource SectionHeader}" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,0,0,12">
                        Bepaal wat er moet gebeuren bij onleesbare sectoren (beschadigde schijf).
                    </TextBlock>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pogingen per slechte sector"
                                   VerticalAlignment="Center" FontSize="13"
                                   Foreground="{StaticResource TextPrimary}" />
                        <TextBox Grid.Column="1" Text="{Binding BadSectorRetries}"
                                 Width="80" HorizontalAlignment="Right"
                                 ToolTip="Standaard: 3 pogingen" />
                    </Grid>

                    <CheckBox Content="Vul onleesbare sectoren op met nullen (aanbevolen)"
                              IsChecked="{Binding ZeroFillBadSectors}" />
                </StackPanel>
            </Border>

            <!--  Case Metadata  -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Zaakgegevens" Style="{StaticResource SectionHeader}" />
                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap" Margin="0,0,0,14">
                        Wordt opgeslagen in het chain-of-custody logboek.
                    </TextBlock>

                    <TextBlock Text="Zaaknummer *" Style="{StaticResource SubLabel}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding CaseNumber, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Bijv. 2026-001" Margin="0,0,0,12" />

                    <TextBlock Text="Bewijsnummer *" Style="{StaticResource SubLabel}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding EvidenceNumber, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Bijv. E-001" Margin="0,0,0,12" />

                    <TextBlock Text="Onderzoeker *" Style="{StaticResource SubLabel}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding ExaminerName, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Uw naam" Margin="0,0,0,12" />

                    <TextBlock Text="Organisatie" Style="{StaticResource SubLabel}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding ExaminerOrganization, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Uw bedrijf of afdeling" Margin="0,0,0,12" />

                    <TextBlock Text="Notities" Style="{StaticResource SubLabel}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="80" TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             ToolTip="Omschrijving of bijzonderheden" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>